RULE freeze writer inside the stand-in window
CLASS com.antivocale.app.byteman.SpikeStandIn
METHOD windowPoint
AT ENTRY
BIND key = "spike-" + System.identityHashCode($0)
IF $0.raceMode == true
DO debug("BYTEMAN: writer frozen inside window"),
   $0.writerFrozen = true,
   waitFor(key, 5000)
ENDRULE
RULE freeze worker before it claims work
CLASS com.antivocale.app.transcription.NativeKeepAlive
METHOD beginWork
AT ENTRY
BIND key = "nka-begin-" + System.identityHashCode($0)
IF java.lang.Boolean.getBoolean("byteman.nka.race") == true
DO java.lang.System.setProperty("byteman.nka.froze", "1"),
   waitFor(key, 5000)
ENDRULE
