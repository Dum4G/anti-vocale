RULE freeze writer inside the stand-in window
CLASS com.antivocale.app.byteman.SpikeStandIn
METHOD windowPoint
AT ENTRY
BIND key = "spike-" + System.identityHashCode($0)
IF $0.raceMode == true
DO debug("BYTEMAN: writer frozen inside window"),
   $0.writerFrozen = true,
   waitFor(key, 5000)
ENDRULE
